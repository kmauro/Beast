# Environment
NODE_ENV=development
TZ=America/Argentina/Buenos_Aires

# HTTP panel/API
API_HOST=0.0.0.0
API_PORT=3000
PANEL_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=replace-with-at-least-12-characters
PANEL_COOKIE_SECURE=false

# MySQL
MYSQL_DATABASE=beast
MYSQL_USER=beast_app
MYSQL_PASSWORD=replace-with-a-long-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-password
DATABASE_URL=mysql://beast_app:replace-with-a-long-password@mysql:3306/beast

# Ollama runs natively on the Windows host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b

# WhatsApp
WHATSAPP_CLIENT_ID=beast-main
WHATSAPP_AUTH_PATH=/app/data/whatsapp-auth
WHATSAPP_HEADLESS=true
BOT_REPLY_ENABLED=false

# Business rules
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
BUSINESS_OPEN_TIME=09:00
BUSINESS_CLOSE_TIME=18:00
SELLER_BATCH_SIZE=5
FOLLOW_UP_AFTER_BUSINESS_HOURS=24
AUTO_CLOSE_AFTER_BUSINESS_HOURS=72
LIFECYCLE_SWEEP_INTERVAL_MS=60000
LABEL_NEW=NUEVO
LABEL_BOT=BOT
LABEL_SELLER_1=VENDEDOR_1
LABEL_SELLER_2=VENDEDOR_2
LABEL_CLOSED=CERRADO
LABEL_OUT_OF_HOURS=FUERA_DE_HORARIO
